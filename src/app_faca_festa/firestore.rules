rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isAtivo() {
      return userExists() && userData().ativo != false;
    }

    function isAdmin() {
      return isAtivo() && userData().tipo == 'A';
    }

    function isTipo(tipo) {
      return isAtivo() && userData().tipo == tipo;
    }

    function eventoDono(eventoId) {
      return signedIn()
        && exists(/databases/$(database)/documents/evento/$(eventoId))
        && get(/databases/$(database)/documents/evento/$(eventoId)).data.id_usuario == uid();
    }

    function orcamentoDoSolicitante(data) {
      return signedIn() && data.id_solicitante == uid();
    }

    function campoIdUsuario(data) {
      return data.id_usuario == uid() || data.idUsuario == uid();
    }

    function campoIdFornecedor(data) {
      return signedIn() && data.id_fornecedor == uid();
    }

    function idUsuarioAusente(data) {
      return !('id_usuario' in data)
        || data.id_usuario == null
        || data.id_usuario == '';
    }

    function emailDoUsuario() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function conviteDoEmail(data) {
      return emailDoUsuario() != ''
        && (
          data.email_normalizado == emailDoUsuario()
          || (data.email is string && data.email.lower() == emailDoUsuario())
        );
    }

    function podeVincularConvitePeloEmail() {
      return conviteDoEmail(resource.data)
        && request.resource.data.id_usuario == uid()
        && (
          !('id_usuario' in resource.data)
          || resource.data.id_usuario == null
          || resource.data.id_usuario == ''
          || resource.data.id_usuario == uid()
        )
        && request.resource.data.id_evento == resource.data.id_evento;
    }

    function conviteClaim(data) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.conviteToken is string
        && request.auth.token.conviteToken.size() >= 16
        && data.convite_token is string
        && data.convite_token == request.auth.token.conviteToken;
    }

    function rsvpDoConvite() {
      return conviteClaim(resource.data)
        && request.resource.data.id_evento == resource.data.id_evento
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['id_usuario', 'idUsuario', 'id_evento', 'id_convidado', 'convite_token']);
    }

    function reservaPresenteDoConvite(eventoId) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.idEvento == eventoId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reservado_por', 'id_convidado', 'data_reserva']);
    }

    function convidadoComContaReal(idConvidado) {
      return signedIn()
        && idConvidado is string
        && idConvidado.size() > 0
        && exists(/databases/$(database)/documents/convidado/$(idConvidado))
        && get(/databases/$(database)/documents/convidado/$(idConvidado)).data.id_usuario == uid();
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      allow create: if isAdmin() || (signedIn() && uid() == userId
        && request.resource.data.get('tipo', '') != 'A'
        && !request.resource.data.keys().hasAny(['migracao_planejamento']));
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && (resource.data.get('tipo', '') != 'A' || resource.data.get('ativo', false) == true)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['tipo', 'mfa_totp_ativo', 'mfa_email_ativo', 'mfa_metodo', 'migracao_planejamento']));
      allow delete: if isAdmin();

      match /enderecos/{enderecoId} {
        allow read, write: if isAdmin() || (signedIn() && uid() == userId);
      }

      match /solicitacoes_lgpd/{solicitacaoId} {
        allow read: if isAdmin() || (signedIn() && uid() == userId);
        allow create: if signedIn()
          && uid() == userId
          && request.resource.data.keys().hasOnly(['id', 'tipo', 'resumo', 'status', 'criado_em', 'id_usuario', 'nome_titular', 'email_titular'])
          && request.resource.data.id == solicitacaoId
          && request.resource.data.id_usuario == userId
          && request.resource.data.tipo in ['acesso', 'correcao', 'exclusao', 'anonimizacao', 'oposicao', 'revogacao']
          && request.resource.data.resumo is string
          && request.resource.data.resumo.size() > 0
          && request.resource.data.resumo.size() <= 500
          && request.resource.data.nome_titular is string
          && request.resource.data.nome_titular.size() <= 120
          && request.resource.data.email_titular is string
          && request.resource.data.email_titular.size() <= 160
          && request.resource.data.status == 'registrada';
        allow update, delete: if isAdmin();
      }
    }

    match /{path=**}/solicitacoes_lgpd/{solicitacaoId} {
      allow read: if isAdmin();
    }

    match /lgpd_protocolos/{protocoloId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // collectionGroup('enderecos') exige regra no ID da coleção, não só no caminho aninhado.
    match /{path=**}/enderecos/{enderecoId} {
      allow read: if isAdmin();
    }

    match /{path=**}/fornecedores/{docId} {
      allow read: if signedIn();
    }

    match /{path=**}/mensagens/{docId} {
      allow read: if signedIn();
    }

    match /tipo_evento/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tema_festa/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categoria_servico/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategoria_servico/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /servico_produto/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /estado/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /cidades/{cidadeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /inspiracoes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /calculadora_itens_base/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && !request.resource.data.keys().hasAny(['referencia_contextual','referencia_rascunho','governanca_contextual']);
      allow update: if isAdmin()
        && request.resource.data.get('referencia_contextual', null) == resource.data.get('referencia_contextual', null)
        && request.resource.data.get('referencia_rascunho', null) == resource.data.get('referencia_rascunho', null)
        && request.resource.data.get('governanca_contextual', null) == resource.data.get('governanca_contextual', null);
      allow delete: if isAdmin() && !resource.data.keys().hasAny(['referencia_contextual','referencia_rascunho','governanca_contextual']);
      match /versoes_contextuais/{versao} { allow read: if signedIn(); }
      match /edicoes_contextuais/{pedido} { allow read: if isAdmin(); }
      match /validacoes_contextuais/{versao} { allow read: if isAdmin(); }
      match /estados_contextuais/{versao} { allow read: if isAdmin(); }
    }

    match /planejamento_compatibilidade/{eventoId} {
      allow read: if isAdmin() || eventoDono(eventoId);
      // Gravação, cópias e transições são exclusivas do serviço autorizado.
      match /inspecoes/{id} { allow read: if isAdmin(); }
      match /transicoes/{id} { allow read: if isAdmin(); }
    }

    match /calculadora_evento_itens/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ia_sugestoes_base/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /calculadora_preferencias/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['versao', 'receitas'])
        && request.resource.data.versao == 1
        && request.resource.data.receitas is list
        && request.resource.data.receitas.size() <= 60;
    }

    function politicaPublicoValida(cfg) {
      return cfg is map
        && (!('verba_confirmacao' in cfg) || (cfg.verba_confirmacao is map
          && cfg.verba_confirmacao.versao == 1 && cfg.verba_confirmacao.fonte == 'organizador'
          && cfg.verba_confirmacao.confirmado_por == uid() && cfg.verba_confirmacao.confirmado_em is string))
        && (!('duracao' in cfg) || (cfg.duracao is int && cfg.duracao >= 1 && cfg.duracao <= 24))
        && (!('perfil' in cfg) || cfg.perfil in ['economico','padrao','premium'])
        && (!('margem' in cfg) || cfg.margem == null || (cfg.margem is number && cfg.margem >= 0 && cfg.margem <= 0.3))
        && (!('verba_alimentacao' in cfg) || cfg.verba_alimentacao == null || (cfg.verba_alimentacao is number && cfg.verba_alimentacao >= 0 && cfg.verba_alimentacao <= 1000000))
        && (!('confirmacoes' in cfg) || (cfg.confirmacoes is map && cfg.confirmacoes.size() <= 20))
        && (!('lista_completude' in cfg) || cfg.lista_completude in ['desconhecida', 'em_preenchimento', 'concluida'])
        && (!('base_confirmada' in cfg) || cfg.base_confirmada is bool)
        && (!('base' in cfg) || cfg.base in ['manual', 'previstos', 'todos', 'nao_recusados', 'confirmados'])
        && (!('base_confirmada' in cfg) || !cfg.base_confirmada || 'base' in cfg)
        && (!('publico' in cfg) || (cfg.publico is map
          && cfg.publico.keys().hasOnly(['adultos', 'criancas', 'bebes'])
          && cfg.publico.adultos is int && cfg.publico.adultos >= 0 && cfg.publico.adultos <= 1000000
          && cfg.publico.criancas is int && cfg.publico.criancas >= 0 && cfg.publico.criancas <= 1000000
          && cfg.publico.bebes is int && cfg.publico.bebes >= 0 && cfg.publico.bebes <= 1000000))
        && (!('base' in cfg) || cfg.base != 'manual' || !('base_confirmada' in cfg) || !cfg.base_confirmada || 'publico' in cfg);
    }

    function agendaPreservada(eventoId) {
      let path = /databases/$(database)/documents/calculadora_operacao/$(eventoId);
      return request.resource.data.get('agenda', []) is list
        && request.resource.data.get('agenda', []).size() <= 20
        && request.resource.data.get('agenda', []) == (exists(path) ? get(path).data.get('agenda', []) : []);
    }
    function planejadorPreservado(eventoId) {
      let path = /databases/$(database)/documents/calculadora_operacao/$(eventoId);
      return request.resource.data.get('planejador', {}) is map
        && request.resource.data.get('planejador', {}).size() <= 20
        && request.resource.data.get('planejador', {}) == (exists(path) ? get(path).data.get('planejador', {}) : {});
    }
    match /calculadora_operacao/{eventoId} {
      match /agenda_confirmacoes/{pedido} { allow read: if eventoDono(eventoId); }
      match /planejador_confirmacoes/{pedido} { allow read: if eventoDono(eventoId); }

      match /entradas/{entradaId} { allow read: if eventoDono(eventoId); }
      match /documentos/{documentoId} { allow read: if eventoDono(eventoId); }
      match /aplicacoes/{pedido} {
        allow read: if eventoDono(eventoId);
      }
      allow read: if isAdmin() || eventoDono(eventoId);
      allow create, update: if eventoDono(eventoId)
        && request.resource.data.id_evento == eventoId
        && request.resource.data.id_usuario == uid()
        && request.resource.data.versao == 1
        && (!exists(/databases/$(database)/documents/calculadora_operacao/$(eventoId))
          || resource.data.get('versao', 1) == 1)
        && request.resource.data.revisao is int
        && request.resource.data.revisao > 0
        && agendaPreservada(eventoId)
        && planejadorPreservado(eventoId)
        && request.resource.data.get('execucao', {}) is map
        && request.resource.data.get('execucao', {}).diff(exists(/databases/$(database)/documents/calculadora_operacao/$(eventoId)) ? resource.data.get('execucao', {}) : {}).affectedKeys().hasOnly(['regras', 'contexto_desatualizado'])
        && (!('configuracao_planejamento' in request.resource.data) || politicaPublicoValida(request.resource.data.configuracao_planejamento))
        && request.resource.data.keys().hasOnly([
          'id_evento', 'id_usuario', 'versao', 'revisao', 'refeicoes', 'lotes', 'execucao', 'revisao_pos_evento', 'configuracao_planejamento', 'agenda', 'planejador'
        ]);
      allow delete: if isAdmin() || eventoDono(eventoId);
    }

    match /evento/{eventoId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isTipo('O') && request.resource.data.id_usuario == uid());
      allow update: if isAdmin()
        || (isTipo('O') && eventoDono(eventoId)
          && request.resource.data.id_usuario == uid());
      allow delete: if isAdmin() || eventoDono(eventoId);

      match /presentes/{presenteId} {
        allow read: if signedIn();
        allow create, delete: if isAdmin() || eventoDono(eventoId);
        allow update: if isAdmin()
          || eventoDono(eventoId)
          || reservaPresenteDoConvite(eventoId);
      }

      match /{subcolecao}/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin() || eventoDono(eventoId);

        match /{sub2}/{doc2} {
          allow read: if signedIn();
          allow write: if isAdmin() || eventoDono(eventoId);
        }
      }
    }

    // list/get separados: OR com convite/e-mail faz a query por id_evento
    // falhar inteira (PERMISSION_DENIED), mesmo para o dono do evento.
    match /convidado/{id} {
      allow list: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
      allow get: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || conviteDoEmail(resource.data)
        || conviteClaim(resource.data);
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || podeVincularConvitePeloEmail()
        || rsvpDoConvite();
      allow delete: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
    }

    match /convidados/{id} {
      allow list: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
      allow get: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || conviteDoEmail(resource.data)
        || conviteClaim(resource.data);
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || podeVincularConvitePeloEmail()
        || rsvpDoConvite();
      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    match /grupos_convidado/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update, delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    function responsavelTarefaValido(data) {
      let convidado = /databases/$(database)/documents/convidado/$(data.id_responsavel);
      let evento = /databases/$(database)/documents/evento/$(data.id_evento);
      return data.id_responsavel is string && data.id_responsavel.size() > 0
        && exists(evento)
        && (get(evento).data.id_usuario == data.id_responsavel
          || (exists(convidado)
            && get(convidado).data.id_evento == data.id_evento));
    }

    function leituraTarefaPorConvite(data) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.idEvento == data.id_evento
        && request.auth.token.idConvidado == data.id_responsavel
        && exists(/databases/$(database)/documents/convidado/$(data.id_responsavel))
        && conviteClaim(get(/databases/$(database)/documents/convidado/$(data.id_responsavel)).data);
    }

    match /tarefa/{id} {
      allow get: if signedIn() && id.matches('calc_exec_.+')
        && !exists(/databases/$(database)/documents/tarefa/$(id));
      allow read: if isAdmin() || eventoDono(resource.data.id_evento)
        || convidadoComContaReal(resource.data.id_responsavel)
        || leituraTarefaPorConvite(resource.data);
      allow create: if (isAdmin() || eventoDono(request.resource.data.id_evento))
        && responsavelTarefaValido(request.resource.data)
        && request.resource.data.status in ['a_fazer', 'em_andamento', 'concluida'];
      allow update: if request.resource.data.id_evento == resource.data.id_evento
        && request.resource.data.status in ['a_fazer', 'em_andamento', 'concluida']
        && (((isAdmin() || eventoDono(resource.data.id_evento))
              && responsavelTarefaValido(request.resource.data))
          || (convidadoComContaReal(resource.data.id_responsavel)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    match /cardapios/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update: if isAdmin() || (eventoDono(resource.data.id_evento) && request.resource.data.id_evento == resource.data.id_evento && request.resource.data.get('id_modelo', null) == resource.data.get('id_modelo', null) && request.resource.data.get('somente_modelo', false) == resource.data.get('somente_modelo', false));
      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);

      match /itens/{itemId} {
        allow read: if signedIn();
        allow create, update: if isAdmin()
          || eventoDono(getAfter(/databases/$(database)/documents/cardapios/$(id)).data.id_evento);
        allow delete: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/cardapios/$(id)).data.id_evento);
      }
    }

    match /fornecedor/{fornecedorId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && uid() == fornecedorId);
      allow update: if isAdmin() || (signedIn() && uid() == fornecedorId);
      allow delete: if isAdmin();

      // Financeiro privado: somente o proprietário. Admin/organizador/outro
      // fornecedor NÃO acessam margens/custos (nem agregados destas coleções).
      function donoFornecedor() {
        return signedIn() && uid() == fornecedorId;
      }
      function subcolecaoFinanceiroPrivada(nome) {
        return nome in [
          'custos_internos',
          'contas_receber',
          'contas_pagar',
          'movimentos_caixa',
          'comprovantes_financeiros',
          'financeiro_resumo',
          'estoque_itens',
          'estoque_reservas',
          'estoque_movimentos'
        ];
      }

      match /custos_internos/{id} {
        allow read, write: if donoFornecedor();
      }
      match /contas_receber/{id} {
        allow read, write: if donoFornecedor();
      }
      match /contas_pagar/{id} {
        allow read, write: if donoFornecedor();
      }
      match /movimentos_caixa/{id} {
        allow read, write: if donoFornecedor();
      }
      match /comprovantes_financeiros/{id} {
        allow read, write: if donoFornecedor();
      }
      match /financeiro_resumo/{id} {
        allow read, write: if donoFornecedor();
      }
      // Estoque empresarial privado (não confundir com lotes da calculadora).
      match /estoque_itens/{id} {
        allow read, write: if donoFornecedor();
      }
      match /estoque_reservas/{id} {
        allow read, write: if donoFornecedor();
      }
      match /estoque_movimentos/{id} {
        allow read, write: if donoFornecedor();
      }

      match /{subcolecao}/{docId} {
        allow read: if signedIn() && !subcolecaoFinanceiroPrivada(subcolecao);
        allow write: if (isAdmin() || uid() == fornecedorId)
          && !subcolecaoFinanceiroPrivada(subcolecao);
      }
    }

    match /fornecedor_categoria/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    match /fornecedor_servico/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update: if isAdmin()
        || campoIdFornecedor(resource.data)
        || campoIdFornecedor(request.resource.data);
      allow delete: if isAdmin() || campoIdFornecedor(resource.data);

      match /avaliacoes/{avaliacaoId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    // create não tem `resource`; usar request.resource no create e resource no update/delete.
    match /servico_foto/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update, delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    match /territorio/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update, delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    function cotacaoDoc(cotacaoId) {
      return get(/databases/$(database)/documents/cotacao/$(cotacaoId)).data;
    }

    function ehSolicitanteCotacao(cotacaoId) {
      return signedIn()
        && cotacaoDoc(cotacaoId).id_usuario_solicitante == uid();
    }

    function ehFornecedorConvidadoCotacao(cotacaoId) {
      return isTipo('F')
        && exists(/databases/$(database)/documents/cotacao/$(cotacaoId)/fornecedores/$(uid()));
    }

    function fornecedorNaCotacao(cotacaoId, fornecedorId) {
      return exists(/databases/$(database)/documents/cotacao/$(cotacaoId)/fornecedores/$(fornecedorId));
    }

    // Organizador da cotação ou o fornecedor da conversa (e admin).
    function participanteChatCotacao(cotacaoId, fornecedorId) {
      return signedIn()
        && fornecedorNaCotacao(cotacaoId, fornecedorId)
        && (
          isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || uid() == fornecedorId
        );
    }

    // Chat ativo: cotação não cancelada e participação não encerrada como perdedor/recusa.
    function chatCotacaoAberto(cotacaoId, fornecedorId) {
      let statusPai = cotacaoDoc(cotacaoId).status;
      let statusForn = get(/databases/$(database)/documents/cotacao/$(cotacaoId)/fornecedores/$(fornecedorId)).data.status;
      return statusPai != 'cancelada'
        && !(statusForn in ['cancelada', 'recusado', 'perdeuCotacao']);
    }

    function mensagemChatValida() {
      return request.resource.data.keys().hasOnly([
          'id_usuario',
          'nome_usuario',
          'mensagem',
          'enviado_em',
          'lido'
        ])
        && request.resource.data.id_usuario == uid()
        && request.resource.data.nome_usuario is string
        && request.resource.data.nome_usuario.size() <= 200
        && request.resource.data.mensagem is string
        && request.resource.data.mensagem.size() > 0
        && request.resource.data.mensagem.size() <= 2000
        && request.resource.data.lido == false
        && request.resource.data.enviado_em is timestamp;
    }

    // Participante só pode marcar lido=true (não altera conteúdo).
    function marcarMensagemLidaValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lido'])
        && request.resource.data.lido == true
        && resource.data.id_usuario != uid();
    }

    // Create/update sensíveis de cotação passam pelas callables (Admin SDK).
    // O cliente só lê e (organizador) cancela/fecha campos permitidos.
    match /cotacao/{cotacaoId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.id_usuario_solicitante == uid())
        || ehFornecedorConvidadoCotacao(cotacaoId);

      allow create: if false;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.id_usuario_solicitante == uid()
          && request.resource.data.id_usuario_solicitante == resource.data.id_usuario_solicitante
          && request.resource.data.id_evento == resource.data.id_evento
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.id_usuario_solicitante == uid());

      match /fornecedores/{fornecedorId} {
        allow read: if isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || uid() == fornecedorId
          || (
            isTipo('F')
            && resource.data.id_fornecedor == uid()
          );

        allow create: if false;

        allow update: if isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || (
            uid() == fornecedorId
            && resource.data.id_fornecedor == uid()
          );

        allow delete: if isAdmin() || ehSolicitanteCotacao(cotacaoId);

        match /{subcolecao}/{docId} {
          allow read: if isAdmin()
            || ehSolicitanteCotacao(cotacaoId)
            || uid() == fornecedorId;

          // servicos e demais subcoleções: só Cloud Functions (Admin SDK).
          allow create: if false;

          allow update, delete: if isAdmin()
            || ehSolicitanteCotacao(cotacaoId)
            || uid() == fornecedorId;
        }

        // Chat é gravado pelo cliente (stream em tempo real).
        match /mensagens/{mensagemId} {
          allow create: if participanteChatCotacao(cotacaoId, fornecedorId)
            && chatCotacaoAberto(cotacaoId, fornecedorId)
            && mensagemChatValida();

          allow update: if participanteChatCotacao(cotacaoId, fornecedorId)
            && marcarMensagemLidaValida();

          allow delete: if false;
        }
      }
    }

    match /orcamento/{id} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            eventoDono(resource.data.id_evento)
            || resource.data.id_fornecedor == uid()
            || orcamentoDoSolicitante(resource.data)
          )
        );

      allow create: if isAdmin()
        || eventoDono(request.resource.data.id_evento)
        || (isTipo('O') && orcamentoDoSolicitante(request.resource.data));

      allow update: if (
          isAdmin()
          || eventoDono(resource.data.id_evento)
          || orcamentoDoSolicitante(resource.data)
          || (signedIn() && resource.data.id_fornecedor == uid())
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['calculadora_conferencia_financeira', 'calculadora_cobre_itens', 'id_evento', 'id_solicitante'])
          || isAdmin()
          || eventoDono(resource.data.id_evento)
          || orcamentoDoSolicitante(resource.data)
        );

      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);

      match /orcamento_gasto/{gastoId} {
        allow read: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/orcamento/$(id)).data.id_evento)
          || orcamentoDoSolicitante(get(/databases/$(database)/documents/orcamento/$(id)).data)
          || (
            signedIn()
            && get(/databases/$(database)/documents/orcamento/$(id)).data.id_fornecedor == uid()
          );

        function despesaValida() {
          return request.resource.data.get('id_orcamento', id) == id
            && request.resource.data.custo is number && request.resource.data.custo > 0 && request.resource.data.custo <= 1000000
            && request.resource.data.pago is number && request.resource.data.pago >= 0 && request.resource.data.pago <= request.resource.data.custo;
        }
        function podeAlterarDespesa() {
          return isAdmin() || eventoDono(get(/databases/$(database)/documents/orcamento/$(id)).data.id_evento)
            || orcamentoDoSolicitante(get(/databases/$(database)/documents/orcamento/$(id)).data);
        }
        allow create, update: if podeAlterarDespesa() && despesaValida();
        allow delete: if podeAlterarDespesa();
      }

      function orcamentoPaiExiste() {
        return exists(/databases/$(database)/documents/orcamento/$(id));
      }

      function orcamentoPai() {
        return get(/databases/$(database)/documents/orcamento/$(id)).data;
      }

      // get() sem exists() no pai falha a avaliação (PERMISSION_DENIED) em list/listen.
      function podeLerFinanceiroOrcamento() {
        return orcamentoPaiExiste() && (
          isAdmin()
          || eventoDono(orcamentoPai().id_evento)
          || orcamentoDoSolicitante(orcamentoPai())
          || (signedIn() && orcamentoPai().id_fornecedor == uid())
        );
      }

      // Comandos críticos (contrato/liquidação) passam por Cloud Functions.
      // Cliente autentizado só lê; escrita direta é negada.
      match /obrigacoes/{obrigacaoId} {
        allow read: if podeLerFinanceiroOrcamento();
        allow write: if false;
      }

      match /liquidacoes/{liquidacaoId} {
        allow read: if podeLerFinanceiroOrcamento();
        allow write: if false;
      }

      match /liquidacoes_idempotencia/{chaveId} {
        allow read: if podeLerFinanceiroOrcamento();
        allow write: if false;
      }
    }

    function podeAcessarCalculadora(data) {
      return isAdmin() || (signedIn() && (
        ('id_usuario' in data && data.id_usuario == uid())
        || ('idUsuario' in data && data.idUsuario == uid())
        || ('id_evento' in data && eventoDono(data.id_evento))
      ));
    }

    function podeLerItensCalculadora(id, subcolecao) {
      let pai = /databases/$(database)/documents/calculadora_festa/$(id);
      // O primeiro save consulta os itens antes de criar o pai. O ID gerado
      // pelo app contém o evento; só seu dono pode consultar esse caminho.
      return isAdmin() || (exists(pai)
        ? podeAcessarCalculadora(get(pai).data)
        : (subcolecao == 'itens' && signedIn() && id.matches('^calc_[^_]+_[0-9]+$')
          && eventoDono(id.split('_')[1])));
    }

    match /calculadora_festa/{id} {
      // A leitura de um destino inicial ainda inexistente permite deduplicar a transação.
      allow get: if signedIn() && id.matches('plano_inicial_.+')
        && !exists(/databases/$(database)/documents/calculadora_festa/$(id));
      // Deduplicação do vínculo de rascunho: somente o dono do evento pode
      // consultar a ausência da identidade estável antes da transação.
      allow get: if signedIn() && id.matches('^calc_[^_]+_[0-9]+$')
        && eventoDono(id.split('_')[1])
        && !exists(/databases/$(database)/documents/calculadora_festa/$(id));
      allow read, delete: if podeAcessarCalculadora(resource.data);
      allow create: if isAdmin() || (
        signedIn() && request.resource.data.id_usuario == uid()
        && eventoDono(request.resource.data.id_evento)
      );
      allow update: if podeAcessarCalculadora(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_evento', 'idUsuario'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_usuario'])
          || (idUsuarioAusente(resource.data) && eventoDono(resource.data.id_evento)
            && request.resource.data.id_usuario == uid())
        );
      match /{subcolecao}/{docId} {
        allow read: if podeLerItensCalculadora(id, subcolecao);
        allow delete: if podeLerItensCalculadora(id, subcolecao);
        allow create, update: if podeAcessarCalculadora(
          getAfter(/databases/$(database)/documents/calculadora_festa/$(id)).data);
      }
    }

    match /fornecedor_interacoes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.id_usuario == uid();
      allow update, delete: if isAdmin();
    }

    match /fornecedor_recomendacoes/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /avaliacao_fornecedor/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /avaliacoes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /fornecedor_avaliacoes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /comentarios/{comentarioId} {
        allow read, write: if signedIn();
      }
    }

    match /password_reset_codes/{id} {
      allow read, write: if false;
    }

    match /mfa_totp/{userId} {
      allow read, write: if false;
    }

    match /mfa_email_codes/{userId} {
      allow read, write: if false;
    }

    // Auditoria imutável: só Cloud Functions gravam.
    // Admin lê tudo. Fornecedor lê apenas o que é dos próprios serviços.
    // Organizador não lê (visão ainda não liberada).
    match /auditoria_eventos/{id} {
      allow get, list: if isAdmin()
        || (isTipo('F')
            && resource.data.id_fornecedor == uid()
            && resource.data.visivel_fornecedor == true);
      allow create, update, delete: if false;
    }

    // Comissão da plataforma: escritas via Functions; leitura admin ou próprio pagador.
    match /plataforma_comissao_politicas/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_comissao_obrigacoes/{id} {
      // list separado: OR com id_pagador faz query sem filtro falhar inteira.
      allow list: if isAdmin()
        || (signedIn() && resource.data.id_pagador == uid());
      allow get: if isAdmin()
        || (signedIn() && resource.data.id_pagador == uid());
      allow write: if false;
    }
    match /plataforma_comissao_liquidacoes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_comissao_ajustes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_comissao_auditoria/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Intermediação (recebimento → alocação → repasse): escrita só via Functions.
    match /plataforma_recebimentos/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_alocacoes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_repasses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_liberacao_repasses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_intermediacao_ajustes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_intermediacao_auditoria/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Mediação (Prompt 03): escrita só via Functions; leitura admin.
    // Cliente/fornecedor consultam via callable com filtro de visibilidade.
    match /plataforma_mediacao_casos/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_mediacao_registros/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /plataforma_mediacao_auditoria/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Declarações de pagamento do cliente (Prompt 04) — escrita só Functions.
    match /plataforma_pagamentos_declarados/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.autor_id == uid());
      allow write: if false;
    }
  }
}
