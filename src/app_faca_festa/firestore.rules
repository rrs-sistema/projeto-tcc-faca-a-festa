rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isAtivo() {
      return userExists() && userData().ativo != false;
    }

    function isAdmin() {
      return isAtivo() && userData().tipo == 'A';
    }

    function isTipo(tipo) {
      return isAtivo() && userData().tipo == tipo;
    }

    function eventoDono(eventoId) {
      return signedIn()
        && exists(/databases/$(database)/documents/evento/$(eventoId))
        && get(/databases/$(database)/documents/evento/$(eventoId)).data.id_usuario == uid();
    }

    function orcamentoDoSolicitante(data) {
      return signedIn() && data.id_solicitante == uid();
    }

    function campoIdUsuario(data) {
      return data.id_usuario == uid() || data.idUsuario == uid();
    }

    function campoIdFornecedor(data) {
      return signedIn() && data.id_fornecedor == uid();
    }

    function idUsuarioAusente(data) {
      return !('id_usuario' in data)
        || data.id_usuario == null
        || data.id_usuario == '';
    }

    function emailDoUsuario() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function conviteDoEmail(data) {
      return emailDoUsuario() != ''
        && (
          data.email_normalizado == emailDoUsuario()
          || (data.email is string && data.email.lower() == emailDoUsuario())
        );
    }

    function podeVincularConvitePeloEmail() {
      return conviteDoEmail(resource.data)
        && request.resource.data.id_usuario == uid()
        && (
          !('id_usuario' in resource.data)
          || resource.data.id_usuario == null
          || resource.data.id_usuario == ''
          || resource.data.id_usuario == uid()
        )
        && request.resource.data.id_evento == resource.data.id_evento;
    }

    function conviteClaim(data) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.conviteToken is string
        && request.auth.token.conviteToken.size() >= 16
        && data.convite_token is string
        && data.convite_token == request.auth.token.conviteToken;
    }

    function rsvpDoConvite() {
      return conviteClaim(resource.data)
        && request.resource.data.id_evento == resource.data.id_evento
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['id_usuario', 'idUsuario', 'id_evento', 'id_convidado', 'convite_token']);
    }

    function reservaPresenteDoConvite(eventoId) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.idEvento == eventoId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reservado_por', 'id_convidado', 'data_reserva']);
    }

    function convidadoComContaReal(idConvidado) {
      return signedIn()
        && idConvidado is string
        && idConvidado.size() > 0
        && exists(/databases/$(database)/documents/convidado/$(idConvidado))
        && get(/databases/$(database)/documents/convidado/$(idConvidado)).data.id_usuario == uid();
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      allow create: if isAdmin() || (signedIn() && uid() == userId);
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['tipo', 'mfa_totp_ativo', 'mfa_email_ativo', 'mfa_metodo']));
      allow delete: if isAdmin();

      match /enderecos/{enderecoId} {
        allow read, write: if isAdmin() || (signedIn() && uid() == userId);
      }

      match /solicitacoes_lgpd/{solicitacaoId} {
        allow read: if isAdmin() || (signedIn() && uid() == userId);
        allow create: if signedIn()
          && uid() == userId
          && request.resource.data.keys().hasOnly(['id', 'tipo', 'resumo', 'status', 'criado_em', 'id_usuario', 'nome_titular', 'email_titular'])
          && request.resource.data.id == solicitacaoId
          && request.resource.data.id_usuario == userId
          && request.resource.data.tipo in ['acesso', 'correcao', 'exclusao', 'anonimizacao', 'oposicao', 'revogacao']
          && request.resource.data.resumo is string
          && request.resource.data.resumo.size() > 0
          && request.resource.data.resumo.size() <= 500
          && request.resource.data.nome_titular is string
          && request.resource.data.nome_titular.size() <= 120
          && request.resource.data.email_titular is string
          && request.resource.data.email_titular.size() <= 160
          && request.resource.data.status == 'registrada';
        allow update, delete: if isAdmin();
      }
    }

    match /{path=**}/solicitacoes_lgpd/{solicitacaoId} {
      allow read: if isAdmin();
    }

    match /lgpd_protocolos/{protocoloId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // collectionGroup('enderecos') exige regra no ID da coleção, não só no caminho aninhado.
    match /{path=**}/enderecos/{enderecoId} {
      allow read: if isAdmin();
    }

    match /{path=**}/fornecedores/{docId} {
      allow read: if signedIn();
    }

    match /{path=**}/mensagens/{docId} {
      allow read: if signedIn();
    }

    match /tipo_evento/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tema_festa/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categoria_servico/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategoria_servico/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /servico_produto/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /estado/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /cidades/{cidadeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /inspiracoes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /calculadora_itens_base/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /calculadora_evento_itens/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ia_sugestoes_base/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /calculadora_operacao/{eventoId} {
      allow read: if isAdmin() || eventoDono(eventoId);
      allow create, update: if eventoDono(eventoId)
        && request.resource.data.id_evento == eventoId
        && request.resource.data.id_usuario == uid()
        && request.resource.data.versao == 1
        && request.resource.data.revisao is int
        && request.resource.data.revisao > 0
        && request.resource.data.keys().hasOnly([
          'id_evento', 'id_usuario', 'versao', 'revisao', 'refeicoes', 'lotes'
        ]);
      allow delete: if isAdmin() || eventoDono(eventoId);
    }

    match /evento/{eventoId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (isTipo('O') && request.resource.data.id_usuario == uid());
      allow delete: if isAdmin() || eventoDono(eventoId);

      match /presentes/{presenteId} {
        allow read: if signedIn();
        allow create, delete: if isAdmin() || eventoDono(eventoId);
        allow update: if isAdmin()
          || eventoDono(eventoId)
          || reservaPresenteDoConvite(eventoId);
      }

      match /{subcolecao}/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin() || eventoDono(eventoId);

        match /{sub2}/{doc2} {
          allow read: if signedIn();
          allow write: if isAdmin() || eventoDono(eventoId);
        }
      }
    }

    // list/get separados: OR com convite/e-mail faz a query por id_evento
    // falhar inteira (PERMISSION_DENIED), mesmo para o dono do evento.
    match /convidado/{id} {
      allow list: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
      allow get: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || conviteDoEmail(resource.data)
        || conviteClaim(resource.data);
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || podeVincularConvitePeloEmail()
        || rsvpDoConvite();
      allow delete: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
    }

    match /convidados/{id} {
      allow list: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data));
      allow get: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || conviteDoEmail(resource.data)
        || conviteClaim(resource.data);
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update: if isAdmin()
        || eventoDono(resource.data.id_evento)
        || (signedIn() && campoIdUsuario(resource.data))
        || podeVincularConvitePeloEmail()
        || rsvpDoConvite();
      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    match /grupos_convidado/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update, delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    function responsavelTarefaValido(data) {
      let convidado = /databases/$(database)/documents/convidado/$(data.id_responsavel);
      let evento = /databases/$(database)/documents/evento/$(data.id_evento);
      return data.id_responsavel is string && data.id_responsavel.size() > 0
        && exists(evento)
        && (get(evento).data.id_usuario == data.id_responsavel
          || (exists(convidado)
            && get(convidado).data.id_evento == data.id_evento));
    }

    function leituraTarefaPorConvite(data) {
      return signedIn()
        && request.auth.token.papel == 'C'
        && request.auth.token.idEvento == data.id_evento
        && request.auth.token.idConvidado == data.id_responsavel
        && exists(/databases/$(database)/documents/convidado/$(data.id_responsavel))
        && conviteClaim(get(/databases/$(database)/documents/convidado/$(data.id_responsavel)).data);
    }

    match /tarefa/{id} {
      allow read: if isAdmin() || eventoDono(resource.data.id_evento)
        || convidadoComContaReal(resource.data.id_responsavel)
        || leituraTarefaPorConvite(resource.data);
      allow create: if (isAdmin() || eventoDono(request.resource.data.id_evento))
        && responsavelTarefaValido(request.resource.data)
        && request.resource.data.status in ['a_fazer', 'em_andamento', 'concluida'];
      allow update: if request.resource.data.id_evento == resource.data.id_evento
        && request.resource.data.status in ['a_fazer', 'em_andamento', 'concluida']
        && (((isAdmin() || eventoDono(resource.data.id_evento))
              && responsavelTarefaValido(request.resource.data))
          || (convidadoComContaReal(resource.data.id_responsavel)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);
    }

    match /cardapios/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || eventoDono(request.resource.data.id_evento);
      allow update, delete: if isAdmin() || eventoDono(resource.data.id_evento);

      match /itens/{itemId} {
        allow read: if signedIn();
        allow write: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/cardapios/$(id)).data.id_evento);
      }
    }

    match /fornecedor/{fornecedorId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && uid() == fornecedorId);
      allow update: if isAdmin() || (signedIn() && uid() == fornecedorId);
      allow delete: if isAdmin();

      match /{subcolecao}/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin() || uid() == fornecedorId;
      }
    }

    match /fornecedor_categoria/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    match /fornecedor_servico/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update: if isAdmin()
        || campoIdFornecedor(resource.data)
        || campoIdFornecedor(request.resource.data);
      allow delete: if isAdmin() || campoIdFornecedor(resource.data);

      match /avaliacoes/{avaliacaoId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    // create não tem `resource`; usar request.resource no create e resource no update/delete.
    match /servico_foto/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update, delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    match /territorio/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || campoIdFornecedor(request.resource.data);
      allow update, delete: if isAdmin() || campoIdFornecedor(resource.data);
    }

    function cotacaoDoc(cotacaoId) {
      return get(/databases/$(database)/documents/cotacao/$(cotacaoId)).data;
    }

    function ehSolicitanteCotacao(cotacaoId) {
      return signedIn()
        && cotacaoDoc(cotacaoId).id_usuario_solicitante == uid();
    }

    function ehFornecedorConvidadoCotacao(cotacaoId) {
      return isTipo('F')
        && exists(/databases/$(database)/documents/cotacao/$(cotacaoId)/fornecedores/$(uid()));
    }

    function fornecedorNaCotacao(cotacaoId, fornecedorId) {
      return exists(/databases/$(database)/documents/cotacao/$(cotacaoId)/fornecedores/$(fornecedorId));
    }

    // Organizador da cotação ou o fornecedor da conversa (e admin).
    function participanteChatCotacao(cotacaoId, fornecedorId) {
      return signedIn()
        && fornecedorNaCotacao(cotacaoId, fornecedorId)
        && (
          isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || uid() == fornecedorId
        );
    }

    function mensagemChatValida() {
      return request.resource.data.keys().hasOnly([
          'id_usuario',
          'nome_usuario',
          'mensagem',
          'enviado_em',
          'lido'
        ])
        && request.resource.data.id_usuario == uid()
        && request.resource.data.nome_usuario is string
        && request.resource.data.nome_usuario.size() <= 200
        && request.resource.data.mensagem is string
        && request.resource.data.mensagem.size() > 0
        && request.resource.data.mensagem.size() <= 2000
        && request.resource.data.lido == false
        && request.resource.data.enviado_em is timestamp;
    }

    // Create/update sensíveis de cotação passam pelas callables (Admin SDK).
    // O cliente só lê e (organizador) cancela/fecha campos permitidos.
    match /cotacao/{cotacaoId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.id_usuario_solicitante == uid())
        || ehFornecedorConvidadoCotacao(cotacaoId);

      allow create: if false;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.id_usuario_solicitante == uid()
          && request.resource.data.id_usuario_solicitante == resource.data.id_usuario_solicitante
          && request.resource.data.id_evento == resource.data.id_evento
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.id_usuario_solicitante == uid());

      match /fornecedores/{fornecedorId} {
        allow read: if isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || uid() == fornecedorId
          || (
            isTipo('F')
            && resource.data.id_fornecedor == uid()
          );

        allow create: if false;

        allow update: if isAdmin()
          || ehSolicitanteCotacao(cotacaoId)
          || (
            uid() == fornecedorId
            && resource.data.id_fornecedor == uid()
          );

        allow delete: if isAdmin() || ehSolicitanteCotacao(cotacaoId);

        match /{subcolecao}/{docId} {
          allow read: if isAdmin()
            || ehSolicitanteCotacao(cotacaoId)
            || uid() == fornecedorId;

          // servicos e demais subcoleções: só Cloud Functions (Admin SDK).
          allow create: if false;

          allow update, delete: if isAdmin()
            || ehSolicitanteCotacao(cotacaoId)
            || uid() == fornecedorId;
        }

        // Chat é gravado pelo cliente (stream em tempo real).
        match /mensagens/{mensagemId} {
          allow create: if participanteChatCotacao(cotacaoId, fornecedorId)
            && mensagemChatValida();
        }
      }
    }

    match /orcamento/{id} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            eventoDono(resource.data.id_evento)
            || resource.data.id_fornecedor == uid()
            || orcamentoDoSolicitante(resource.data)
          )
        );

      allow create: if isAdmin()
        || eventoDono(request.resource.data.id_evento)
        || (isTipo('O') && orcamentoDoSolicitante(request.resource.data));

      allow update: if (
          isAdmin()
          || eventoDono(resource.data.id_evento)
          || orcamentoDoSolicitante(resource.data)
          || (signedIn() && resource.data.id_fornecedor == uid())
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['calculadora_conferencia_financeira', 'calculadora_cobre_itens', 'id_evento', 'id_solicitante'])
          || isAdmin()
          || eventoDono(resource.data.id_evento)
          || orcamentoDoSolicitante(resource.data)
        );

      allow delete: if isAdmin() || eventoDono(resource.data.id_evento);

      match /orcamento_gasto/{gastoId} {
        allow read: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/orcamento/$(id)).data.id_evento)
          || orcamentoDoSolicitante(get(/databases/$(database)/documents/orcamento/$(id)).data)
          || (
            signedIn()
            && get(/databases/$(database)/documents/orcamento/$(id)).data.id_fornecedor == uid()
          );

        allow create: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/orcamento/$(id)).data.id_evento)
          || orcamentoDoSolicitante(get(/databases/$(database)/documents/orcamento/$(id)).data);

        allow update, delete: if isAdmin()
          || eventoDono(get(/databases/$(database)/documents/orcamento/$(id)).data.id_evento)
          || orcamentoDoSolicitante(get(/databases/$(database)/documents/orcamento/$(id)).data);
      }
    }

    function podeAcessarCalculadora(data) {
      return isAdmin() || (signedIn() && (
        ('id_usuario' in data && data.id_usuario == uid())
        || ('idUsuario' in data && data.idUsuario == uid())
        || ('id_evento' in data && eventoDono(data.id_evento))
      ));
    }

    function podeLerItensCalculadora(id, subcolecao) {
      let pai = /databases/$(database)/documents/calculadora_festa/$(id);
      // O primeiro save consulta os itens antes de criar o pai. O ID gerado
      // pelo app contém o evento; só seu dono pode consultar esse caminho.
      return isAdmin() || (exists(pai)
        ? podeAcessarCalculadora(get(pai).data)
        : (subcolecao == 'itens' && signedIn() && id.matches('^calc_[^_]+_[0-9]+$')
          && eventoDono(id.split('_')[1])));
    }

    match /calculadora_festa/{id} {
      allow read, delete: if podeAcessarCalculadora(resource.data);
      allow create: if isAdmin() || (
        signedIn() && request.resource.data.id_usuario == uid()
        && eventoDono(request.resource.data.id_evento)
      );
      allow update: if podeAcessarCalculadora(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_evento', 'idUsuario'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_usuario'])
          || (idUsuarioAusente(resource.data) && eventoDono(resource.data.id_evento)
            && request.resource.data.id_usuario == uid())
        );
      match /{subcolecao}/{docId} {
        allow read: if podeLerItensCalculadora(id, subcolecao);
        allow delete: if podeLerItensCalculadora(id, subcolecao);
        allow create, update: if podeAcessarCalculadora(
          getAfter(/databases/$(database)/documents/calculadora_festa/$(id)).data);
      }
    }

    match /fornecedor_interacoes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.id_usuario == uid();
      allow update, delete: if isAdmin();
    }

    match /fornecedor_recomendacoes/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /avaliacao_fornecedor/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /avaliacoes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /fornecedor_avaliacoes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /comentarios/{comentarioId} {
        allow read, write: if signedIn();
      }
    }

    match /password_reset_codes/{id} {
      allow read, write: if false;
    }

    match /mfa_totp/{userId} {
      allow read, write: if false;
    }

    match /mfa_email_codes/{userId} {
      allow read, write: if false;
    }

    // Auditoria imutável: só Cloud Functions gravam.
    // Admin lê tudo. Fornecedor lê apenas o que é dos próprios serviços.
    // Organizador não lê (visão ainda não liberada).
    match /auditoria_eventos/{id} {
      allow get, list: if isAdmin()
        || (isTipo('F')
            && resource.data.id_fornecedor == uid()
            && resource.data.visivel_fornecedor == true);
      allow create, update, delete: if false;
    }
  }
}
